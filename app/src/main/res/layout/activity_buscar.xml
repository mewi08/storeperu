<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?android:colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar producto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="10dp" />

    <!-- ID + Botón Buscar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="15dp">

        <EditText
            android:id="@+id/edtId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ID del producto"
            android:inputType="number"
            android:background="@drawable/rounded_rectangle" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/success"
            android:text="Buscar" />

    </LinearLayout>

    <!-- Nombre -->
    <EditText
        android:id="@+id/edtNombreB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre"
        android:inputType="text"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_rectangle"/>

    <!-- Categoría -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Categoría:"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCategoriaB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbJuguetesB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juguetes" />

            <RadioButton
                android:id="@+id/rbTecnologiaB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tecnología" />

            <RadioButton
                android:id="@+id/rbRopaB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ropa" />

            <RadioButton
                android:id="@+id/rbHogarB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hogar" />

        </RadioGroup>

    </LinearLayout>

    <!-- Descripción -->
    <EditText
        android:id="@+id/edtDescripcionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción"
        android:inputType="text"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_rectangle"/>

    <!-- Garantía -->
    <EditText
        android:id="@+id/edtGarantiaB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Garantía"
        android:inputType="number"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_rectangle"/>

    <!-- Precio -->
    <EditText
        android:id="@+id/edtPrecioB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Precio"
        android:inputType="numberDecimal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_rectangle"/>

    <!-- Stock -->
    <EditText
        android:id="@+id/edtStockB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Stock"
        android:inputType="number"
        android:layout_marginBottom="15dp"
        android:background="@drawable/rounded_rectangle"/>

    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/info"
        android:text="Actualizar" />

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/danger"
        android:text="Eliminar" />

    <Button
        android:id="@+id/btnLimpiar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/gray"
        android:text="Limpiar" />

</LinearLayout>